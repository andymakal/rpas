# Vercel "Preview" environment variables for the access-protected review deployment.
#
# PURPOSE
#   A Vercel Preview deployment that Bob and Andy open to review in-development
#   changes. It shows REAL production *information* via the Supabase `development`
#   branch (a persistent, with-data clone of production), while the real
#   production database is physically unreachable from this deployment.
#
# WHY NOT POINT AT PRODUCTION DIRECTLY
#   The app talks to Supabase with the SERVICE-ROLE key (createAdminClient),
#   which bypasses RLS. There is no database-level read-only mode available to
#   the app, and the write surface is large (server actions, many /api routes,
#   3 cron routes). "Read-only against production" cannot be enforced safely in
#   application code alone. Targeting the development clone removes the risk at
#   the source: writes land on the disposable clone, never on production.
#
# HOW TO SET (choose one)
#   Dashboard: Vercel project -> Settings -> Environment Variables -> add each
#     var below with the "Preview" environment checked (NOT "Production").
#   CLI:       vercel env add <NAME> preview   (paste value when prompted)
#
# -----------------------------------------------------------------------------

# Supabase DEVELOPMENT branch (ref: buoztddompdsuccfcixk). NOT production.
# This URL is the development branch and is safe to point Preview at.
NEXT_PUBLIC_SUPABASE_URL=https://buoztddompdsuccfcixk.supabase.co

# Development-branch anon key (role=anon, ref=buoztddompdsuccfcixk).
# Copy from .env.local (it is the development branch key, not production).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<dev-branch-anon-key>

# Development-branch service-role key (role=service_role, ref=buoztddompdsuccfcixk).
# Copy from .env.local. MUST be the development-branch key. The admin client
# refuses to run against the production ref outside a production deployment, so
# a production key pasted here will hard-fail the build/runtime by design.
SUPABASE_SERVICE_ROLE_KEY=<dev-branch-service-role-key>

# Leave UNSET on Preview so the financial-review AI routes cannot call the
# external Anthropic API from the review environment.
# ANTHROPIC_API_KEY=

# Dummy value so cron routes reject any manual trigger. Vercel scheduled crons
# only run on Production deployments, not Preview, so this is belt-and-braces.
CRON_SECRET=preview-disabled

# Point invite/site links at the preview origin instead of the production URL.
# Replace with the actual preview URL once Vercel assigns it, or leave unset.
# NEXT_PUBLIC_SITE_URL=https://<preview-deployment-url>
